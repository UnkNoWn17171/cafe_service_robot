<?xml version="1.0"?>
<package format="2">
  <name>cafe_service_robot</name>
  <version>0.0.1</version>
  <description>Kafe ortaminda masalara otonom servis yapan ROS/Gazebo robotu.
  TurtleBot3 tabanli, gmapping ile haritalanmis, amcl + move_base ile navige
  ediliyor. Masa secimi web arayuzunden yapiliyor.</description>

  <maintainer email="agumustafaa@gmail.com">Mustafa</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- CMakeLists.txt icindeki find_package satirinda gecenler -->
  <depend>rospy</depend>
  <!-- Python kodundan import edilenler (catkin_lint bunlari goremez) -->
  <exec_depend>actionlib</exec_depend>
  <exec_depend>actionlib_msgs</exec_depend>
  <exec_depend>move_base_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>

  <!-- Launch dosyalarindan calistirilan node'lar -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>dwa_local_planner</exec_depend>
  <exec_depend>gmapping</exec_depend>
  <exec_depend>rviz</exec_depend>

  <!-- TurtleBot3 model, dunya, amcl ve rviz konfigurasyonu -->
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>turtlebot3_navigation</exec_depend>
  <exec_depend>turtlebot3_slam</exec_depend>

  <!-- Arayuzler -->
  <exec_depend>python3-flask</exec_depend>

  <export>
  </export>
</package>
